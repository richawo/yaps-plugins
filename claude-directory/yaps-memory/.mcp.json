{
  "mcpServers": {
    "yaps-memory": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/mcp/memory.mjs"
      ],
      "env": {
        "YAPS_PLUGIN_ID": "yaps-memory",
        "YAPS_PLUGIN_VERSION": "1.1.1",
        "YAPS_PLUGIN_HOST": "claude-code",
        "YAPS_PLUGIN_TRANSPORT": "mcp",
        "YAPS_MCP_CLIENT_ID": "claude-code",
        "YAPS_MCP_AUTO_AUTHORIZE_READ": "0"
      }
    }
  }
}
