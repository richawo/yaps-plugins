{
  "mcpServers": {
    "yaps-dictation": {
      "command": "npx",
      "args": [
        "--yes",
        "--package",
        "yaps-cursor-runtime@0.3.0",
        "yaps-plugin-media"
      ],
      "env": {
        "YAPS_PLUGIN_ID": "yaps-dictation",
        "YAPS_PLUGIN_VERSION": "0.1.0",
