{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "yaps": {
        "type": "local",
        "command": [
          "npx",
          "--yes",
          "--package",
          "https://codeload.github.com/richawo/yaps-plugins/tar.gz/827cbbadbe27c0f3b00e5a091b36c139a56f4e55",
          "yaps-plugin-media"
        ],
        "environment": {
          "YAPS_PLUGIN_ID": "yaps-all",
          "YAPS_PLUGIN_VERSION": "1.1.1",
          "YAPS_PLUGIN_HOST": "opencode",
          "YAPS_PLUGIN_TRANSPORT": "mcp"
        }
      },
      "yaps-memory": {
        "type": "local",
        "command": [
          "npx",
          "--yes",
          "--package",
          "https://codeload.github.com/richawo/yaps-plugins/tar.gz/827cbbadbe27c0f3b00e5a091b36c139a56f4e55",
          "yaps-plugin-memory"
        ],
        "environment": {
          "YAPS_PLUGIN_ID": "yaps-all",
          "YAPS_PLUGIN_VERSION": "1.1.1",
          "YAPS_PLUGIN_HOST": "opencode",
          "YAPS_PLUGIN_TRANSPORT": "mcp",
          "YAPS_MCP_CLIENT_ID": "local-mcp",
          "YAPS_MCP_AUTO_AUTHORIZE_READ": "0"
        }
      }
    },
    "timeout": {
      "startup": 120000,
      "execution": 1800000
    }
  }
}
