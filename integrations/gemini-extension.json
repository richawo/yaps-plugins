{
  "name": "yaps",
  "version": "1.1.0",
  "description": "Transcribe recordings, create captions and voice-overs, translate, clean audio, and edit images and video with Yaps. Includes 14 skills and optional private memory. Requires the local Yaps app and a Yaps account.",
  "contextFileName": "GEMINI.md",
  "mcpServers": {
    "yaps": {
      "command": "npx",
      "args": [
        "--yes",
        "--package",
        "https://codeload.github.com/richawo/yaps-plugins/tar.gz/c96839613550a79bc7b805285b700b8c681fffd4",
        "yaps-plugin-media"
      ],
      "env": {
        "YAPS_PLUGIN_ID": "yaps-all",
        "YAPS_PLUGIN_VERSION": "1.1.0",
        "YAPS_PLUGIN_HOST": "gemini-cli",
        "YAPS_PLUGIN_TRANSPORT": "mcp"
      },
      "timeout": 1800000
    },
    "yaps-memory": {
      "command": "npx",
      "args": [
        "--yes",
        "--package",
        "https://codeload.github.com/richawo/yaps-plugins/tar.gz/c96839613550a79bc7b805285b700b8c681fffd4",
        "yaps-plugin-memory"
      ],
      "env": {
        "YAPS_PLUGIN_ID": "yaps-all",
        "YAPS_PLUGIN_VERSION": "1.1.0",
        "YAPS_PLUGIN_HOST": "gemini-cli",
        "YAPS_PLUGIN_TRANSPORT": "mcp",
        "YAPS_MCP_CLIENT_ID": "local-mcp",
        "YAPS_MCP_AUTO_AUTHORIZE_READ": "0"
      },
      "timeout": 1800000
    }
  }
}
