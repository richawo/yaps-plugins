{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "yaps": {
      "type": "local",
      "command": [
        "npx",
        "--yes",
        "--package",
        "https://codeload.github.com/richawo/yaps-plugins/tar.gz/c96839613550a79bc7b805285b700b8c681fffd4",
        "yaps-plugin-media"
      ],
      "environment": {
        "YAPS_PLUGIN_ID": "yaps-all",
        "YAPS_PLUGIN_VERSION": "1.1.0",
        "YAPS_PLUGIN_HOST": "opencode",
        "YAPS_PLUGIN_TRANSPORT": "mcp"
      },
      "enabled": true,
      "timeout": 120000
    },
    "yaps-memory": {
      "type": "local",
      "command": [
        "npx",
        "--yes",
        "--package",
        "https://codeload.github.com/richawo/yaps-plugins/tar.gz/c96839613550a79bc7b805285b700b8c681fffd4",
        "yaps-plugin-memory"
      ],
      "environment": {
        "YAPS_PLUGIN_ID": "yaps-all",
        "YAPS_PLUGIN_VERSION": "1.1.0",
        "YAPS_PLUGIN_HOST": "opencode",
        "YAPS_PLUGIN_TRANSPORT": "mcp",
        "YAPS_MCP_CLIENT_ID": "local-mcp",
        "YAPS_MCP_AUTO_AUTHORIZE_READ": "0"
      },
      "enabled": true,
      "timeout": 120000
    }
  }
}
