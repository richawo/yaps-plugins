{
  "mcpServers": {
    "yaps": {
      "command": "node",
      "args": [
        "./scripts/launch.mjs"
      ],
      "cwd": ".",
      "env": {
        "YAPS_PLUGIN_ID": "yaps",
        "YAPS_PLUGIN_VERSION": "0.2.0",
        "YAPS_PLUGIN_HOST": "cursor",
        "YAPS_PLUGIN_TRANSPORT": "mcp"
      }
    },
    "yaps-memory": {
      "command": "node",
      "args": [
        "./scripts/launch-memory.mjs"
      ],
      "cwd": ".",
      "env": {
        "YAPS_PLUGIN_ID": "yaps",
        "YAPS_PLUGIN_VERSION": "0.2.0",
        "YAPS_PLUGIN_HOST": "cursor",
        "YAPS_PLUGIN_TRANSPORT": "mcp",
        "YAPS_MCP_CLIENT_ID": "cursor",
        "YAPS_MCP_AUTO_AUTHORIZE_READ": "0"
      }
    }
  }
}
