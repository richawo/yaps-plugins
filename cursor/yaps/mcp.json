{
  "mcpServers": {
    "yaps": {
      "command": "npx",
      "args": [
        "--yes",
        "--package",
        "https://codeload.github.com/richawo/yaps-plugins/tar.gz/7eb507e766da9cd72f1e3e2c1c4299612bded5cf",
        "yaps-plugin-media"
      ],
      "env": {
        "YAPS_PLUGIN_ID": "yaps",
        "YAPS_PLUGIN_VERSION": "0.2.0",
        "YAPS_PLUGIN_HOST": "cursor",
        "YAPS_PLUGIN_TRANSPORT": "mcp"
      }
    },
    "yaps-memory": {
      "command": "npx",
      "args": [
        "--yes",
        "--package",
        "https://codeload.github.com/richawo/yaps-plugins/tar.gz/7eb507e766da9cd72f1e3e2c1c4299612bded5cf",
        "yaps-plugin-memory"
      ],
      "env": {
        "YAPS_PLUGIN_ID": "yaps",
        "YAPS_PLUGIN_VERSION": "0.2.0",
        "YAPS_PLUGIN_HOST": "cursor",
        "YAPS_PLUGIN_TRANSPORT": "mcp",
        "YAPS_MCP_CLIENT_ID": "cursor",
        "YAPS_MCP_AUTO_AUTHORIZE_READ": "0"
      }
    }
  }
}
