{
  "name": "yaps-cursor-runtime",
  "version": "0.3.1",
  "description": "Shared local MCP runtime for the twelve focused Yaps Cursor plugins",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "yaps-plugin-media": "cursor/yaps/scripts/launch.mjs",
    "yaps-plugin-memory": "cursor/yaps/scripts/launch-memory.mjs"
  },
  "files": [
    "cursor/yaps/helper/",
    "cursor/yaps/scripts/",
    "cursor/yaps/skills/",
    "cursor/yaps/.cursor-plugin/",
    "cursor/yaps/mcp.json",
    "cursor/yaps/README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/richawo/yaps-plugins.git"
  },
  "homepage": "https://yaps.ai",
  "bugs": {
    "url": "https://github.com/richawo/yaps-plugins/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
